px'&gt;data, prompt injection&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#2E7D57;strokeColor=none;fontColor=#FFFFFF;fontFamily=Helvetica;spacing=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="211.42857142857142" y="340" width="150" height="96" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b style='font-size:13px'&gt;Hybrid retrieval&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;glossary expansion,&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;BM25 + dense (RRF)&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;top 20 candidates&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#C2571A;strokeColor=none;fontColor=#FFFFFF;fontFamily=Helvetica;spacing=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="382.85714285714283" y="340" width="150" height="96" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b style='font-size:13px'&gt;Rerank&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;MiniLM cross-encoder&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;top 5, ≤ 2 per document&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#C2571A;strokeColor=none;fontColor=#FFFFFF;fontFamily=Helvetica;spacing=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="554.2857142857142" y="340" width="150" height="96" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b style='font-size:13px'&gt;Guard 2 · relevance&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;best rerank score&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;below −4 → decline&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#2E7D57;strokeColor=none;fontColor=#FFFFFF;fontFamily=Helvetica;spacing=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="725.7142857142857" y="340" width="150" height="96" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b style='font-size:13px'&gt;Generate&lt;/b&gt;&lt;br&gt;&lt;spa