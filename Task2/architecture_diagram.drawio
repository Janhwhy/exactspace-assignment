<mxfile host="drawio"><diagram name="RAG architecture" id="rag"><mxGraphModel dx="1600" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1500" pageHeight="680" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="OFFLINE INGESTION  ·  run once per document set (~10 s for 11 PDFs)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#2F6B8F;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b style='font-size:14px'&gt;11 PDFs&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;manuals, SOPs,&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;troubleshooting guides&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#2F6B8F;strokeColor=none;fontColor=#FFFFFF;fontFamily=Helvetica;spacing=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="238" height="86" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b style='font-size:14px'&gt;Parse and clean&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;PyMuPDF layout blocks&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;headers / footers removed&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#2F6B8F;strokeColor=none;fontColor=#FFFFFF;fontFamily=Helvetica;spacing=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="318" y="60" width="238" height="86" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style='font-size:14px'&gt;Redact personal data&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;emails and phone numbers&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;removed before indexing&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#2E7D57;strokeColor=none;fontColor=#FFFFFF;fontFamily=Helvetica;spa